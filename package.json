{
  "name": "lazyvcs.nvim",
  "private": true,
  "scripts": {
    "format:md": "prettier --write \"**/*.md\"",
    "format:md:check": "prettier --check \"**/*.md\"",
    "lint:md": "node tests/ci/lint-markdown.mjs",
    "lint:links": "node --test tests/ci/check-local-links.test.mjs && node tests/ci/check-local-links.mjs",
    "audit": "npm audit --include=dev --audit-level=high"
  },
  "devDependencies": {
    "markdownlint": "0.42.0",
    "mdast-util-from-markdown": "2.1.0",
    "prettier": "3.9.10"
  },
  "overrides": {
    "katex": "0.18.2",
    "re2js": "2.8.7"
  }
}
